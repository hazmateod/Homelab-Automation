---
- name: Verify DNS
  ansible.builtin.command: getent hosts {{ maintenance.dns_test }}
  register: dns_validation
  changed_when: false
  failed_when: false

- name: Gather service facts
  ansible.builtin.service_facts:

- name: Build validation results
  ansible.builtin.set_fact:
    validation_results: "{{ validation_results | default({}) | combine({
      item: {
        'running':
          (
            item + '.service' in ansible_facts.services and
            ansible_facts.services[item + '.service'].state == 'running'
          )
      }
    }) }}"
  loop: "{{ validation_services | default([]) }}"

- name: Store validation report
  ansible.builtin.set_fact:
    homelab_report: >-
      {{
        homelab_report |
        combine({
          'validation': {
            'dns': {
              'status': 'PASS' if dns_validation.rc == 0 else 'FAIL',
              'lookup': maintenance.dns_test
            },
            'services': validation_results
          }
        }, recursive=True)
      }}

- name: Display Validation Report
  ansible.builtin.debug:
    var: homelab_report.validation
