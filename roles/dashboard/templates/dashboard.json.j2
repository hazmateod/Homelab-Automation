{
  "generated": "{{ ansible_date_time.iso8601 }}",
  "host_count": {{ dashboard_hosts | length }},
  "hosts": [
{% for host in dashboard_hosts %}
    {
      "hostname": "{{ host.metadata.hostname }}",
      "ip": "{{ host.network.primary_ip | default('Unknown') }}",
      "os": "{{ host.metadata.operating_system }}",
      "kernel": "{{ host.metadata.kernel }}",
      "score": {{ host.health.overall.score | default(0) }},
      "status": "{{ host.health.overall.status | default('UNKNOWN') }}"
    }{% if not loop.last %},{% endif %}
{% endfor %}
  ]
}
