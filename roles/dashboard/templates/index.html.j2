<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>HIMP Dashboard</title>

<link rel="stylesheet" href="style.css">

<meta http-equiv="refresh" content="300">

</head>

<body>

<header>
    <h1>🏠 Homelab Infrastructure Management Platform</h1>
    <p>Generated {{ ansible_date_time.iso8601 }}</p>
</header>

{% set stats = namespace(
    healthy=0,
    warning=0,
    critical=0,
    total_score=0,
    scored_hosts=0
) %}

{% for host in dashboard_hosts %}

    {% set status = host.health.overall.status | default('UNKNOWN') %}

    {% if status == 'HEALTHY' %}
        {% set stats.healthy = stats.healthy + 1 %}
    {% elif status == 'WARNING' %}
        {% set stats.warning = stats.warning + 1 %}
    {% elif status == 'CRITICAL' %}
        {% set stats.critical = stats.critical + 1 %}
    {% endif %}

    {% if host.health.overall.score is defined %}
        {% set stats.total_score = stats.total_score + (host.health.overall.score | int) %}
        {% set stats.scored_hosts = stats.scored_hosts + 1 %}
    {% endif %}

{% endfor %}

<section class="summary">

<div class="card">
<h2>{{ dashboard_hosts | length }}</h2>
<p>🖥 Total Hosts</p>
</div>

<div class="card">
<h2>{{ stats.healthy }}</h2>
<p>🟢 Healthy</p>
</div>

<div class="card">
<h2>{{ stats.warning }}</h2>
<p>🟡 Warning</p>
</div>

<div class="card">
<h2>{{ stats.critical }}</h2>
<p>🔴 Critical</p>
</div>

<div class="card">
<h2>
{% if stats.scored_hosts > 0 %}
{{ (stats.total_score / stats.scored_hosts) | round(0) }}%
{% else %}
0%
{% endif %}
</h2>

<p>⭐ Average Health</p>
</div>

</section>

<section>

<table>

<thead>

<tr>
<th>Hostname</th>
<th>IP Address</th>
<th>Operating System</th>
<th>Status</th>
<th>Score</th>
<th>Report</th>
</tr>

</thead>

<tbody>

{% for host in dashboard_hosts | sort(attribute='metadata.hostname') %}

<tr>

<td>{{ host.metadata.hostname }}</td>

<td>{{ host.network.primary_ip | default('Unknown') }}</td>

<td>{{ host.metadata.operating_system }}</td>

<td class="{{ host.health.overall.status | default('unknown') | lower }}">
{{ host.health.overall.status | default('UNKNOWN') }}
</td>

<td>
{{ host.health.overall.score | default(0) }}%
</td>

<td>
<a href="../current/{{ host.metadata.hostname }}.md">
View
</a>
</td>

</tr>

{% endfor %}

</tbody>

</table>

</section>

<script src="dashboard.js"></script>

</body>
</html>
