[Unit]
Description=Homelab Infrastructure Management Platform
After=network.target

[Service]
Type=simple

User=himp
Group=himp

WorkingDirectory=/opt/himp

Environment=HOME=/var/lib/himp
Environment=PATH=/opt/himp/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/himp
Environment=ANSIBLE_PRIVATE_KEY_FILE=/var/lib/himp/.ssh/id_ed25519
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/himp/database.env
EnvironmentFile=-/etc/himp/notifications.env

ExecStart=/opt/himp/.venv/bin/uvicorn himp.api.server:app --host 127.0.0.1 --port 9347 --proxy-headers --forwarded-allow-ips 127.0.0.1

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

ReadWritePaths=/opt/himp/data
ReadWritePaths=/opt/himp/inventory
ReadWritePaths=/opt/himp/logs
ReadWritePaths=/opt/himp/reports
ReadWritePaths=/opt/himp/playbooks/reports
ReadWritePaths=/var/lib/himp/.ansible
ReadWritePaths=/var/lib/himp/.ssh

[Install]
WantedBy=multi-user.target
