[Unit]
Description=HIMP Scheduled Maintenance Updates
After=network-online.target himp-inventory-sync.service
Wants=network-online.target

[Service]
Type=oneshot

User=himp
Group=himp

WorkingDirectory=/opt/himp

Environment=HOME=/var/lib/himp
Environment=PATH=/opt/himp/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONPATH=/opt/himp
Environment=ANSIBLE_PRIVATE_KEY_FILE=/var/lib/himp/.ssh/id_ed25519
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/himp/database.env

ExecStart=/opt/himp/.venv/bin/python -m himp.cli automation-run scheduled_updates
