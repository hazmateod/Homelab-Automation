# HIMP database backend configuration
#
# Production configuration belongs at:
#
#   /etc/himp/database.env
#
# Never store the production database password in Git.
#
# SQLite remains HIMP's default when no database environment
# file is installed.

HIMP_DATABASE_BACKEND=postgresql
HIMP_DATABASE_HOST=himpdb01.server.arpa
HIMP_DATABASE_PORT=5432
HIMP_DATABASE_NAME=himp
HIMP_DATABASE_USER=himp_app
HIMP_DATABASE_PASSWORD=REPLACE_WITH_EXTERNAL_SECRET
